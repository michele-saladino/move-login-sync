{
  "name": "move-login-sync",
  "version": "1.1.0",
  "description": "",
  "scripts": {
    "dev": "pnpm build:chrome --watch",
    "dev:firefox": "pnpm build:firefox --watch",
    "build": "vue-tsc --noEmit && pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "vite build --mode chrome && vite build --mode chrome --config vite.content.config.ts",
    "build:firefox": "vite build --mode firefox && vite build --mode firefox --config vite.content.config.ts",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir dist --overwrite-dest",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "web-ext": "10.8.0"
  },
  "private": true
}
